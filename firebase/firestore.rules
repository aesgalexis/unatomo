rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isLaundryServicesAdmin() {
      return isSignedIn()
        && request.auth.token.laundryServicesAdmin == true;
    }

    function isAcceptedAdminOfMachine(ownerUid, machineId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admin_machine_links/$(machineId + "_" + request.auth.uid))
        && get(/databases/$(database)/documents/admin_machine_links/$(machineId + "_" + request.auth.uid)).data.adminUid == request.auth.uid
        && get(/databases/$(database)/documents/admin_machine_links/$(machineId + "_" + request.auth.uid)).data.ownerUid == ownerUid
        && get(/databases/$(database)/documents/admin_machine_links/$(machineId + "_" + request.auth.uid)).data.status == "accepted";
    }

    match /registration_codes/{code} {
      allow read, write: if false;
    }

    match /email_outbox/{messageId} {
      allow read, write: if false;
    }

    match /admin_invite_email_batches/{batchId} {
      allow read, write: if false;
    }

    match /access_requests/{requestId} {
      allow read, write: if false;
    }

    match /email_request_limits/{limitId} {
      allow read, write: if false;
    }

    match /account_email_changes/{userId} {
      allow read, write: if false;
    }

    match /public_metrics/{metricId} {
      allow get: if metricId == "nfc";
      allow list, write: if false;
    }

    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;

      allow create: if false;

      allow update: if isSignedIn()
                    && request.auth.uid == uid
                    && (
                      (
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(["company", "photoURL", "updatedAt"])
                        && (!request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(["company"])
                          || (request.resource.data.company is string
                            && request.resource.data.company.size() <= 60))
                        && (!request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(["photoURL"])
                          || request.resource.data.photoURL == null
                          || (request.resource.data.photoURL is string
                            && request.resource.data.photoURL.size() <= 2048))
                      )
                    );

      allow delete: if false;
    }

    match /user_notification_preferences/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, delete: if false;
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys()
          .hasOnly(["email", "schemaVersion", "updatedAt"])
        && request.resource.data.schemaVersion in [1, 2]
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.email is map
        && request.resource.data.email.keys().hasOnly([
          "enabled", "events", "receiveOwnedMachines",
          "notifyAdministrators", "receiveAdministeredMachines"
        ])
        && request.resource.data.email.enabled is bool
        && (!request.resource.data.email.keys().hasAny(["receiveOwnedMachines"])
          || request.resource.data.email.receiveOwnedMachines is bool)
        && (!request.resource.data.email.keys().hasAny(["notifyAdministrators"])
          || request.resource.data.email.notifyAdministrators is bool)
        && (!request.resource.data.email.keys().hasAny(["receiveAdministeredMachines"])
          || request.resource.data.email.receiveAdministeredMachines is bool)
        && request.resource.data.email.events is map
        && request.resource.data.email.events.keys().hasOnly([
          "machineOutOfService", "machineOperationalAgain"
        ])
        && request.resource.data.email.events.machineOutOfService is bool
        && request.resource.data.email.events.machineOperationalAgain is bool;
    }

    match /user_notifications/{notificationId} {
      allow get, list: if isSignedIn()
        && resource.data.recipientUid == request.auth.uid;
      allow create, delete: if false;
      allow update: if isSignedIn()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.recipientUid == resource.data.recipientUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readAt"])
        && (request.resource.data.readAt == null
          || request.resource.data.readAt is timestamp);
    }

    match /tags/{tagId} {
      allow get, list: if isSignedIn();

      allow create, update: if isSignedIn()
        && (
          (resource == null || resource.data.tenantId == null || resource.data.tenantId == "")
            ? request.resource.data.tenantId == request.auth.uid
            : resource.data.tenantId == request.auth.uid
        );

      allow delete: if false;
    }

    match /tenants/{tenantId} {
      allow read: if isOwner(tenantId);
      allow write: if false;

      match /{document=**} {
        allow read: if isOwner(tenantId);
        allow write: if false;
      }
    }

    match /account_directory/{emailLower} {
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.emailLower is string
        && request.resource.data.emailLower == emailLower
        && !request.resource.data.keys().hasAny(["accountHandle"]);

      allow update: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.emailLower is string
        && request.resource.data.emailLower == emailLower
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(["accountHandle"]);

      allow delete: if false;
    }

    match /account_handles/{handle} {
      allow read, write: if false;
    }

    match /account_handle_history/{entryId} {
      allow read, write: if false;
    }

    match /dashboard_layout/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(["groups", "placements"]);
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(["groups", "placements"]);
      allow delete: if false;
    }

    match /admin_machine_invites/{inviteId} {
      function ownerInviteSide() {
        return isSignedIn()
          && resource != null
          && resource.data.ownerUid == request.auth.uid;
      }

      function adminInviteSide() {
        return isSignedIn()
          && resource != null
          && request.auth.token.email != null
          && (
            (resource.data.adminEmailLower is string
              && request.auth.token.email == resource.data.adminEmailLower)
            ||
            (resource.data.adminEmail is string
              && request.auth.token.email == resource.data.adminEmail)
          );
      }

      allow get, list: if (resource != null) && (ownerInviteSide() || adminInviteSide());
      allow write: if false;
    }

    match /admin_machine_links/{linkId} {
      function ownerSide() {
        return isSignedIn()
          && resource != null
          && resource.data.ownerUid == request.auth.uid;
      }

      function adminSide() {
        return isSignedIn()
          && resource != null
          && resource.data.adminUid == request.auth.uid;
      }

      allow get, list: if (resource != null) && (ownerSide() || adminSide());
      allow write: if false;
    }

    match /machine_transfer_invites/{inviteId} {
      function transferSenderSide() {
        return isSignedIn()
          && resource != null
          && resource.data.fromOwnerUid == request.auth.uid;
      }

      function transferRecipientSide() {
        return isSignedIn()
          && resource != null
          && resource.data.toOwnerUid == request.auth.uid;
      }

      allow get, list: if (resource != null) && (transferSenderSide() || transferRecipientSide());
      allow write: if false;
    }

    match /machines/{machineId} {
      allow read: if isSignedIn()
        && resource.data.ownerUid is string
        && (resource.data.ownerUid == request.auth.uid
          || isAcceptedAdminOfMachine(resource.data.ownerUid, machineId));
      allow create: if false;
      allow update: if isSignedIn()
        && resource.data.ownerUid is string
        && (resource.data.ownerUid == request.auth.uid
          || isAcceptedAdminOfMachine(resource.data.ownerUid, machineId))
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'status',
          'activeStatusCycleId',
          'lastStatusOperationId',
          'lastStatusRestoreTaskId',
          'lastStatusEventId'
        ]);
      allow delete: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    match /machine_domain_events/{eventId} {
      allow read, write: if false;
    }

    match /usernames/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.ownerUid is string
        && request.resource.data.machineId is string
        && (request.resource.data.ownerUid == request.auth.uid
          || isAcceptedAdminOfMachine(request.resource.data.ownerUid, request.resource.data.machineId));
      allow delete: if isSignedIn()
        && resource.data.ownerUid is string
        && (resource.data.ownerUid == request.auth.uid
          || isAcceptedAdminOfMachine(resource.data.ownerUid, resource.data.machineId));
    }

    match /machine_access/{tagId} {
      allow get: if resource != null
        && canManageMachineAccess(resource.data.tenantId, resource.data.machineId);
      allow list: if false;

      function canManageMachineAccess(tenantId, machineId) {
        return isSignedIn()
          && (request.auth.uid == tenantId || isAcceptedAdminOfMachine(tenantId, machineId));
      }

      allow create: if canManageMachineAccess(request.resource.data.tenantId, request.resource.data.machineId);
      allow update: if canManageMachineAccess(resource.data.tenantId, resource.data.machineId);
      allow delete: if isSignedIn() && resource.data.tenantId == request.auth.uid;
    }

    match /machine_access_sessions/{sessionId} {
      allow read, write: if false;
    }

    match /agregador_maquinaria_LS/{machineId} {
      allow read: if true;
      allow create, update: if isLaundryServicesAdmin();
      allow delete: if false;
    }

    match /maquinaria_counters/{prefix} {
      allow read, create, update: if isLaundryServicesAdmin();
      allow delete: if false;
    }

    match /laundry_public_catalog/{catalogId} {
      function isValidPublicCatalogDocument() {
        return request.resource.data.publishedAt is timestamp
          && request.resource.data.publishedBy == request.auth.uid
          && (
            (catalogId == "meta"
              && request.resource.data.type == "meta"
              && request.resource.data.version is int
              && request.resource.data.version > 0
              && request.resource.data.updatedAt is string
              && request.resource.data.activeManufacturerIds is list)
            || (catalogId == "categories"
              && request.resource.data.type == "categories"
              && request.resource.data.items is list)
            || (catalogId != "meta"
              && catalogId != "categories"
              && request.resource.data.type == "manufacturer"
              && request.resource.data.manufacturer is map
              && request.resource.data.modelGroups is list
              && request.resource.data.spareParts is list)
          );
      }

      allow read: if true;
      allow create, update: if isLaundryServicesAdmin()
        && isValidPublicCatalogDocument();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
