{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "test:task-visibility": "npm run build && node test/taskVisibility.test.cjs",
    "test:machine-policy": "npm run build && node test/machinePolicy.test.cjs",
    "test:machine-status": "npm run build && node test/machineStatusTransitions.test.cjs",
    "test:machine-notifications": "npm run build && node test/machineStatusRecipients.test.cjs",
    "test:email-templates": "npm run build && node test/emailTemplates.test.cjs",
    "catalog:check": "node scripts/syncLaundryCatalog.cjs",
    "catalog:sync": "node scripts/syncLaundryCatalog.cjs --apply",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.4.1",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "ts-deepmerge": "8.0.0",
    "uuid": "11.1.1"
  },
  "private": true
}
